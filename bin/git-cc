#!/bin/zsh

# Write commit using the conventional commit format
#
# Add Jira ID to scope if present in the branch name

NEEDS_STAGING=(git diff --cached --name-only)

if [[ -n $NEEDS_STAGING ]]; then
  git add -A .
fi

TYPE=$(gum choose "fix" "feat" "docs" "style" "refactor" "test" "chore" "revert")
JIRA=$(git symbolic-ref --short HEAD | egrep -o -m 1 "[a-zA-Z]{3,}-[\d]{3,}" | xargs echo)
SCOPE=$(gum input --value "$JIRA" --placeholder "Jira ID")

test -n "$SCOPE" && SCOPE="($SCOPE)"

SUMMARY=$(gum input --value "$TYPE$SCOPE: " --placeholder "Summary of this change")

gum confirm "Commit changes?" && git commit -m "$SUMMARY" "$@"
