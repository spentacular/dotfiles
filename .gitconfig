[core]
  excludesfile = ~/.gitignore_global
  editor = hx
  quotepath = false
  pager = delta

[user]
	name = Spencer Hamm
	email = spentacular@gmail.com

[init]
  defaultBranch = main

[commit]
  verbose = true

[push]
  # https://git-scm.com/docs/git-config#git-config-pushdefault
  default = current
  autoSetupRemote = true

[pull]
  rebase = true
  autoStash = true

[merge]
  conflictStyle = zdiff3

[fetch]
  prune = true

[status]
  branch = true
  short = true
  showStash = true
  showUntrackedFiles = all  # show individual untracked files

[alias]
  # basics
  a = add
  b = branch
  c = commit
  d = diff
  f = fetch
  g = grep
  l = log
  m = merge
  o = checkout
  p = pull
  r = remote
  s = status
  w = whatchanged

  aa = add --all
  amend = commit --amend
  branches = branch -a --color -v
  cm = commit -m
  lol = log --graph --decorate --pretty=oneline --abbrev-commit
  st = status
  prune = fetch --prune
  undo = reset --soft HEAD^
  who = shortlog --summary --

[filter "lfs"]
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process

[delta]
  syntax-theme = Dracula
  navigate = true
  side-by-side = true
  dark = true
  hunk-header-style = omit

[interactive]
  diffFilter = delta --color-only

[color]
  ui = true

[include]
  path = ~/.gitconfig.local
